{
  "name": "actions-cache",
  "main": "lib/restoreCache.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc && ncc build -o dist/restore src/restore.ts && ncc build -o dist/save src/save.ts && ncc build -o dist/saveOnly src/saveOnly.ts",
    "test": "tsc --noEmit && vitest run --coverage",
    "test:unit": "tsc --noEmit && vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/lib-storage": "^3.1030.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "volta": {
    "node": "24.14.0"
  }
}
